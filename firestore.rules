rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Código de 6 caracteres → id da casa. Qualquer pessoa logada pode
    // consultar (para entrar em uma casa), mas isso sozinho não dá acesso
    // aos dados da casa — só o passo seguinte (entrar em cleaning_houses) dá.
    match /cleaning_invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/cleaning_houses/$(resource.data.houseId)).data.memberUids;
    }

    // Lembra em qual casa cada conta está. Só a própria pessoa lê/escreve a sua.
    match /cleaning_users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // O documento da casa: moradores, tarefas, ocorrências e histórico moram
    // todos dentro dele (sincronização por documento único).
    match /cleaning_houses/{houseId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Criar uma casa nova: você precisa estar na sua própria lista de moradores.
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;

      allow update: if signedIn() && (
        // já é morador: pode mexer em qualquer coisa da casa
        request.auth.uid in resource.data.memberUids
        ||
        // está entrando agora: só pode se adicionar à lista de moradores,
        // sem tocar em tarefas, ocorrências ou histórico nesse mesmo passo
        (
          request.auth.uid in request.resource.data.memberUids &&
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.tasks == resource.data.tasks &&
          request.resource.data.occurrences == resource.data.occurrences &&
          request.resource.data.events == resource.data.events
        )
      );

      allow delete: if false;
    }
  }
}
